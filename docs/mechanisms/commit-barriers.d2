vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24 } }
direction: right

a: "write files\nand manifest.tmp" { style.fill: "#F4F1EA" }
b: "order_files_and_directory\nfsync files and directory,\none F_BARRIERFSYNC" { style.fill: "#F4F1EA" }
c: "replace\ntmp to manifest-N" { style.fill: "#F4F1EA" }
d: "sync_directory\nfsync, then F_FULLFSYNC\n(acknowledged)" { style.fill: "#FBE3C8" }
a -> b -> c -> d
