# completion: an owned operation issues one primitive at a time to the driver the host picks.
# Render: d2 --layout elk --sketch --theme 302 docs/completion.d2 docs/completion.svg
vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24 } }
direction: down

op: "owned operation\none primitive at a time"
sync: "synchronous driver"
linux: "io_uring (Linux)"
bsd: "POSIX AIO\n(FreeBSD, macOS)"
asio: "Asio coroutines"
result: "the original's result\nnever fabricated"
op -> sync
op -> linux
op -> bsd
op -> asio
sync -> result
linux -> result
bsd -> result
asio -> result
